<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartGroceryList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartGroceryList.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- 
        Login flow will be handled separately. 
        For now, we go straight to the main app view.
    -->

    <TabBar>
        <ShellContent
            Title="Products"
            ContentTemplate="{DataTemplate views:ProductsPage}"
            Route="ProductsPage" />
        <ShellContent
            Title="Grocery Lists"
            ContentTemplate="{DataTemplate views:ProductsPage}" 
            Route="GroceryListsPage" />
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:ProductsPage}" 
            Route="DashboardPage" />
    </TabBar>

</Shell>
