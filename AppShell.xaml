<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SmartGroceryList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SmartGroceryList.Views"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource SurfaceLight}"
    ForegroundColor="{StaticResource Gray900}"
    TitleColor="{StaticResource Gray900}"
    DisabledColor="{StaticResource Gray500}"
    UnselectedColor="{StaticResource Gray500}"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}">

    <TabBar>
        <ShellContent
            Title="Catalog"
            ContentTemplate="{DataTemplate views:ProductsPage}"
            Route="ProductsPage" />
        <ShellContent
            Title="Lists"
            ContentTemplate="{DataTemplate views:GroceryListsPage}"
            Route="GroceryListsPage" />
        <ShellContent
            Title="Favorites"
            ContentTemplate="{DataTemplate views:FavoritesPage}"
            Route="FavoritesPage" />
    </TabBar>

</Shell>
