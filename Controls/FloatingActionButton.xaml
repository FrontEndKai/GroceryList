<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartGroceryList.Controls.FloatingActionButton"
             WidthRequest="56" HeightRequest="56">
    <Frame CornerRadius="28" BackgroundColor="{StaticResource PrimaryGreenBrush}" Padding="0" HasShadow="True" HorizontalOptions="End" VerticalOptions="End">
        <ImageButton x:Name="FabButton" Source="add_white.png" WidthRequest="56" HeightRequest="56" BackgroundColor="Transparent" Clicked="OnClicked"/>
    </Frame>
</ContentView>