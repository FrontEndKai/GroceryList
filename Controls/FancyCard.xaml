<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartGroceryList.Controls.FancyCard">
    <Border Style="{StaticResource CardStyle}">
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
            <Image Source="placeholder.png" WidthRequest="72" HeightRequest="72" Aspect="AspectFill" Grid.RowSpan="2" />
            <Label x:Name="TitleLabel" Grid.Column="1" Text="Title" Style="{StaticResource TitleText}" />
            <Label x:Name="SubtitleLabel" Grid.Column="1" Grid.Row="1" Text="Subtitle" Style="{StaticResource CaptionText}" />
            <ImageButton Source="heart_outline.png" BackgroundColor="Transparent" HorizontalOptions="End" VerticalOptions="Start" WidthRequest="28" HeightRequest="28" Grid.Column="1" />
        </Grid>
    </Border>
</ContentView>