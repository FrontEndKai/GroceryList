<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartGroceryList.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F7FFFE, Dark=#102226}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 34"
                    Background="{StaticResource PrimaryGradient}"
                    Padding="28"
                    Margin="0,12,0,8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SMART GROCERY"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12" />
                    <Label Text="A modern grocery experience"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="30" />
                    <Label Text="Premium white and turquoise styling with a clean, professional feel across the app."
                           TextColor="White"
                           Opacity="0.9"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Background="White"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Image Source="dotnet_bot.png"
                           HeightRequest="150"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="Quick start"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#102226" />

                    <Label Text="Jump into the product dashboard to search, browse, and manage groceries right away."
                           FontSize="13"
                           TextColor="#6E6E6E" />

                    <Button x:Name="CounterBtn"
                            Text="Open Products"
                            Clicked="OnCounterClicked"
                            BackgroundColor="#18C2C0"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" Background="#EAFDFC" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Clean" FontSize="24" FontAttributes="Bold" TextColor="#0E7C86" />
                        <Label Text="Simple, modern UI" FontSize="13" TextColor="#102226" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 22" Background="#EAFDFC" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Fast" FontSize="24" FontAttributes="Bold" TextColor="#0E7C86" />
                        <Label Text="Search and browse" FontSize="13" TextColor="#102226" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
