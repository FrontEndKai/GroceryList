<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SmartGroceryList.ViewModels"
             x:Class="SmartGroceryList.Views.LoginPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F7FFFE, Dark=#102226}">
    <ContentPage.BindingContext>
        <viewModels:LoginViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 34"
                    Background="{StaticResource PrimaryGradient}"
                    Padding="28"
                    Margin="0,12,0,8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="SMART GROCERY"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="12" />
                    <Label Text="Fresh groceries, beautifully managed"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="30" />
                    <Label Text="A clean, modern entry screen that matches the new turquoise and white product dashboard."
                           TextColor="White"
                           Opacity="0.9"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    Background="White"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Sign in"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="#102226" />

                    <Entry Placeholder="Username" Text="{Binding Username}" />
                    <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />

                    <Button Text="Login"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="#18C2C0"
                            TextColor="White" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" Color="#18C2C0" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 22"
                    Background="#EAFDFC"
                    Padding="16">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Don't have an account?" TextColor="#102226" />
                    <Label Text="Sign Up" TextColor="#0E7C86" FontAttributes="Bold">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSignupCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
