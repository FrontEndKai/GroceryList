<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryMate.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GroceryMate.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.AnimationType>
                <toolkit:FadeAnimation Opacity="1" Length="500"/>
            </toolkit:AnimationBehavior.AnimationType>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto,*" Padding="24" Background="{StaticResource HeroGradient}">
        <VerticalStackLayout Spacing="12">
            <Label Text="GroceryMate" Style="{StaticResource DisplayTitle}" />
            <Label Text="Your curated cart for every aisle." Style="{StaticResource HeroSubTitle}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="Signature" Style="{StaticResource TagLabel}" />
                <Label Text="Curated" Style="{StaticResource ChipLabel}" />
                <Label Text="Seasonal" Style="{StaticResource TagLabel}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource HeroCard}" Margin="0,22,0,0">
            <Border.Behaviors>
                <toolkit:AnimationBehavior EventName="Loaded">
                    <toolkit:AnimationBehavior.AnimationType>
                        <toolkit:FadeAnimation Opacity="1" Length="600"/>
                    </toolkit:AnimationBehavior.AnimationType>
                </toolkit:AnimationBehavior>
            </Border.Behaviors>
            <VerticalStackLayout VerticalOptions="Center" Spacing="12">

                <Border Style="{StaticResource InputCard}">
                    <VerticalStackLayout Spacing="8" Padding="16">
                        <Label Text="Email" Style="{StaticResource FormLabel}"/>
                        <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" Style="{StaticResource InputEntry}"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InputCard}">
                    <VerticalStackLayout Spacing="8" Padding="16">
                        <Label Text="Password" Style="{StaticResource FormLabel}"/>
                        <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" Style="{StaticResource InputEntry}"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Login"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0">
                    <Button.Behaviors>
                        <toolkit:AnimationBehavior EventName="Loaded">
                            <toolkit:AnimationBehavior.AnimationType>
                                <toolkit:FadeAnimation Opacity="1" Length="600"/>
                            </toolkit:AnimationBehavior.AnimationType>
                        </toolkit:AnimationBehavior>
                    </Button.Behaviors>
                </Button>

                <Button Text="Don't have an account? Sign Up"
                            Command="{Binding GoToSignupCommand}"
                            Style="{StaticResource GhostButton}">
                    <Button.Behaviors>
                        <toolkit:AnimationBehavior EventName="Loaded">
                            <toolkit:AnimationBehavior.AnimationType>
                                <toolkit:FadeAnimation Opacity="1" Length="600"/>
                            </toolkit:AnimationBehavior.AnimationType>
                        </toolkit:AnimationBehavior>
                    </Button.Behaviors>
                </Button>

                <Label Text="Tip: demo@grocerymate.com / password123" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
