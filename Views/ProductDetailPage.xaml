<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:GroceryMate.Models"
             xmlns:vm="clr-namespace:GroceryMate.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GroceryMate.Views.ProductDetailPage"
             x:DataType="vm:ProductDetailViewModel"
             Title="Product Detail"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.Animation>
                <toolkit:FadeAnimation Opacity="1" Duration="500"/>
            </toolkit:AnimationBehavior.Animation>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <ScrollView>
        <VerticalStackLayout Spacing="16">
            <Image Source="{Binding Product.ImageUrl}" Aspect="AspectFill" HeightRequest="250">
                <Image.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="100"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Image.Behaviors>
            </Image>

            <Border Style="{StaticResource HeroCard}" Margin="20, -50, 20, 0">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="200"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Product.Name}" Style="{StaticResource DisplayTitle}" />
                    <Label Text="{Binding Product.Description}" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="20,0">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="300"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Description" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Product.Description}" Style="{StaticResource BodyText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}" Margin="20,0">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="400"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Price" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding Product.Price}" Style="{StaticResource PriceLabel}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Add to Grocery List" Command="{Binding AddToCartCommand}" Style="{StaticResource PrimaryButton}" Margin="20">
            </Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
