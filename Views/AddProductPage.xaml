<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryMate.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GroceryMate.Views.AddProductPage"
             x:DataType="vm:AddProductViewModel"
             Title="Add New Product"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.Animation>
                <toolkit:FadeAnimation Opacity="1" Duration="500"/>
            </toolkit:AnimationBehavior.Animation>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">
            <Border Style="{StaticResource HeroCard}">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="100"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="8">
                    <Label Text="New Product" Style="{StaticResource DisplayTitle}" />
                    <Label Text="Keep your pantry updated with fresh entries." Style="{StaticResource HeroSubTitle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.Animation>
                            <toolkit:FadeInAnimation Duration="600" Delay="200"/>
                        </toolkit:AnimationBehavior.Animation>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Product Details" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Product Name" Text="{Binding Name}" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Editor Placeholder="Description" Text="{Binding Description}" AutoSize="TextChanges" Style="{StaticResource InputEditor}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Category" Text="{Binding Category}" Style="{StaticResource InputEntry}"/>
                    </Border>
                    
                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Price" Text="{Binding Price}" Keyboard="Numeric" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Store" Text="{Binding Store}" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Unit (e.g., kg, lb, oz)" Text="{Binding Unit}" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Button Text="Save Product" Command="{Binding SaveProductCommand}" Style="{StaticResource PrimaryButton}">
