<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GroceryMate.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GroceryMate.Views.AddProductPage"
             x:DataType="vm:AddProductViewModel"
             Title="Add New Product"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.AnimationType>
                <toolkit:FadeAnimation Opacity="1" Length="500"/>
            </toolkit:AnimationBehavior.AnimationType>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">
            <Border Style="{StaticResource HeroCard}">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.AnimationType>
                            <toolkit:FadeAnimation Opacity="1" Length="600"/>
                        </toolkit:AnimationBehavior.AnimationType>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="8">
                    <Label Text="New Product" Style="{StaticResource DisplayTitle}" />
                    <Label Text="Keep your pantry updated with fresh entries." Style="{StaticResource HeroSubTitle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SurfaceCard}">
                <Border.Behaviors>
                    <toolkit:AnimationBehavior EventName="Loaded">
                        <toolkit:AnimationBehavior.AnimationType>
                            <toolkit:FadeAnimation Opacity="1" Length="600"/>
                        </toolkit:AnimationBehavior.AnimationType>
                    </toolkit:AnimationBehavior>
                </Border.Behaviors>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Product Details" Style="{StaticResource SectionTitle}" />

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Product name" Text="{Binding Name}" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Editor Placeholder="Description" Text="{Binding Description}" AutoSize="TextChanges" Style="{StaticResource InputEditor}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <VerticalStackLayout Spacing="8" Padding="16">
                            <Label Text="Category" Style="{StaticResource FormLabel}"/>
                            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <VerticalStackLayout Spacing="8" Padding="16">
                            <Label Text="Store" Style="{StaticResource FormLabel}"/>
                            <Picker ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Price" Text="{Binding PriceText}" Keyboard="Numeric" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Border Style="{StaticResource InputCard}">
                        <Entry Placeholder="Unit (e.g., kg, lb, oz)" Text="{Binding Unit}" Style="{StaticResource InputEntry}"/>
                    </Border>

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource Tomato}"
                           IsVisible="{Binding HasStatus}" />

                    <Button Text="Save product"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"/>

                    <Button Text="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource GhostButton}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
