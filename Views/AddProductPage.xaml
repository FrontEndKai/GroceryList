                        <Color x:Static="Black"/>
                    </Button.TextColor>
                    <Button.TextShadow>
                        <Color x:Static="Black"/>
                    </Button.TextShadow>
                    <Button.Effects>
                        <BorderEffect BorderColor="Black" BorderThickness="2"/>
                    </Button.Effects>
                    <Button.ImageSource>
                        <FileImageSource File="save.png"/>
