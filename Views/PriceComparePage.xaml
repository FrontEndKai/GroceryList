<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GroceryMate.Views.PriceComparePage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:m="clr-namespace:GroceryMate.Models"
             xmlns:viewmodel="clr-namespace:GroceryMate.ViewModels"
             x:DataType="viewmodel:PriceCompareViewModel"
             Title="Price Compare"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.AnimationType>
                <toolkit:FadeAnimation Opacity="1" Length="500"/>
            </toolkit:AnimationBehavior.AnimationType>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <VerticalStackLayout Spacing="16" Padding="20">
        <Border Style="{StaticResource HeroCard}">
            <Border.Behaviors>
                <toolkit:AnimationBehavior EventName="Loaded">
                    <toolkit:AnimationBehavior.AnimationType>
                        <toolkit:FadeAnimation Opacity="1" Length="600"/>
                    </toolkit:AnimationBehavior.AnimationType>
                </toolkit:AnimationBehavior>
            </Border.Behaviors>
            <VerticalStackLayout Spacing="8">
                <Label Text="Compare prices" Style="{StaticResource DisplayTitle}" />
                <Label Text="See the best store for your pick." Style="{StaticResource HeroSubTitle}" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource SurfaceCard}">
            <Border.Behaviors>
                <toolkit:AnimationBehavior EventName="Loaded">
                    <toolkit:AnimationBehavior.AnimationType>
                        <toolkit:FadeAnimation Opacity="1" Length="600"/>
                    </toolkit:AnimationBehavior.AnimationType>
                </toolkit:AnimationBehavior>
            </Border.Behaviors>
            <VerticalStackLayout Spacing="12">
                <Label Text="Pick a product" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource InputCard}">
                    <Picker ItemsSource="{Binding Products}" ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedProduct}" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <CollectionView ItemsSource="{Binding PriceOptions}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:PriceOption">
                    <Border Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,0,10">
                        <Border.Behaviors>
                            <toolkit:AnimationBehavior EventName="Loaded">
                                <toolkit:AnimationBehavior.AnimationType>
                                    <toolkit:FadeAnimation Opacity="1" Length="500"/>
                                </toolkit:AnimationBehavior.AnimationType>
                            </toolkit:AnimationBehavior>
                        </Border.Behaviors>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Text="{Binding Store}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:0.00}'}" Style="{StaticResource PriceLabel}" />
                            <Label Grid.Row="1" Text="{Binding Note}" Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Best" TextColor="{StaticResource Primary}"
                                   IsVisible="{Binding IsBest}" FontSize="12" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
