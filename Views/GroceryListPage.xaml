<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:GroceryMate.Models"
             xmlns:vm="clr-namespace:GroceryMate.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GroceryMate.Views.GroceryListPage"
             x:DataType="vm:GroceryListViewModel"
             Title="Grocery List"
             BackgroundColor="{StaticResource Cream}">
    <ContentPage.Behaviors>
        <toolkit:AnimationBehavior EventName="Loaded">
            <toolkit:AnimationBehavior.AnimationType>
                <toolkit:FadeAnimation Opacity="1" Length="500"/>
            </toolkit:AnimationBehavior.AnimationType>
        </toolkit:AnimationBehavior>
    </ContentPage.Behaviors>
    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0" Style="{StaticResource HeroCard}">
            <Border.Behaviors>
                <toolkit:AnimationBehavior EventName="Loaded">
                    <toolkit:AnimationBehavior.AnimationType>
                        <toolkit:FadeAnimation Opacity="1" Length="600"/>
                    </toolkit:AnimationBehavior.AnimationType>
                </toolkit:AnimationBehavior>
            </Border.Behaviors>
            <VerticalStackLayout Spacing="8">
                <Label Text="Your List" Style="{StaticResource DisplayTitle}" />
                <Label Grid.Column="1" Text="{Binding TotalCost, StringFormat='₱{0:N2}'}" Style="{StaticResource MetricLabel}" />
                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Tap items to adjust quantities." Style="{StaticResource HeroSubTitle}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None" Margin="10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:GroceryItem">
                    <Border Style="{StaticResource SurfaceCard}" Padding="12" Margin="10,5">
                        <Border.Behaviors>
                            <toolkit:AnimationBehavior EventName="Loaded">
                                <toolkit:AnimationBehavior.AnimationType>
                                    <toolkit:FadeAnimation Opacity="1" Length="500"/>
                                </toolkit:AnimationBehavior.AnimationType>
                            </toolkit:AnimationBehavior>
                        </Border.Behaviors>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <CheckBox IsChecked="{Binding IsChecked}" Color="{StaticResource Primary}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Product.Name}" Style="{StaticResource BodyText}" />
                                <Label Text="{Binding Quantity, StringFormat='{0}x'}" Style="{StaticResource ChipLabel}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                        Text="Remove"
                                        Style="{StaticResource QuietPillButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroceryListViewModel}}, Path=RemoveCommand}"
                                        CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="20" Padding="16">
            <Border.Behaviors>
                <toolkit:AnimationBehavior EventName="Loaded">
                    <toolkit:AnimationBehavior.AnimationType>
                        <toolkit:FadeAnimation Opacity="1" Length="600"/>
                    </toolkit:AnimationBehavior.AnimationType>
                </toolkit:AnimationBehavior>
            </Border.Behaviors>
            <Label Text="{Binding TotalCost, StringFormat='Estimated total: ₱{0:N2}'}"
                   Style="{StaticResource SectionTitle}"
                   VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
