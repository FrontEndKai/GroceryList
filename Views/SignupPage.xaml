<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartGroceryList.Views.SignupPage"
             Title="Sign Up">
    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        <Label 
            Text="Create Account"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Entry Placeholder="Username" />
        <Entry Placeholder="Email" />
        <Entry Placeholder="Password" IsPassword="True" />
        <Entry Placeholder="Confirm Password" IsPassword="True" />

        <Button Text="Sign Up" HorizontalOptions="Fill" />

        <Label HorizontalOptions="Center" Text="Already have an account? Login" >
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLoginTapped" />
            </Label.GestureRecognizers>
        </Label>
    </VerticalStackLayout>
</ContentPage>
